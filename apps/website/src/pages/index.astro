---
import { brand } from '@jscebu/brand';
import { getCollection } from 'astro:content';
import Cursor from '../components/Cursor.astro';
import ProjectCard from '../components/ProjectCard.astro';
import Sticker from '../components/Sticker.astro';
import Site from '../layouts/Site.astro';

const featured = (await getCollection('projects', ({ data }) => data.featured)).sort((a, b) => a.data.order - b.data.order);
const links = (await getCollection('links')).sort((a, b) => a.data.order - b.data.order);
const photo = brand.assets.find((a) => a.id === 'photo')!.path;

const work = [
  { title: 'Meetups', text: 'Talks, demos and lightning talks from developers building in Cebu.' },
  { title: 'Workshops', text: 'Hands-on sessions, from automated testing to building with AI.' },
  { title: 'Hacktoberfest Cebu', text: 'A month of open source every October, with partner communities.', href: 'https://hacktoberfest.jscebu.org' },
];
---

<Site
  title="JavaScript Cebu"
  description="JavaScript Cebu is the JavaScript developer community in Cebu, Philippines: meetups, workshops and Hacktoberfest Cebu."
  current="home"
>
  <div class="wrap">
    <section id="hero" class="hero">
      <div class="copy">
        <p class="jc-label kicker">// cebu's javascript community</p>
        <h1 class="jc-headline"><Cursor text="Build things. Ship them. Together" blink /></h1>
        <p class="lede">Meetups, workshops and Hacktoberfest, run by developers in Cebu.</p>
        <div class="actions">
          <a class="btn primary jc-mono" href="#events">Upcoming events ↓</a>
          <a class="btn jc-mono" href="#join">Join us</a>
        </div>
      </div>
      <Sticker size="clamp(120px, 22vw, 232px)" class="hero-sticker" alt="" />
    </section>

    <section id="what-we-do" class="block">
      <h2 class="jc-label">What we do</h2>
      <ul class="cards">
        {
          work.map((w) => (
            <li>
              {w.href ? (
                <a href={w.href}>
                  <h3>{w.title} ↗</h3>
                  <p>{w.text}</p>
                </a>
              ) : (
                <div>
                  <h3>{w.title}</h3>
                  <p>{w.text}</p>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </section>

    <section id="events" class="block">
      <h2 class="jc-label">Upcoming events</h2>
      <p class="big">Our next meetups and workshops, along with every other Cebu tech event, are on Cebby.</p>
      <div class="actions">
        <a class="btn primary jc-mono" href="https://www.getcebby.com">See events on Cebby ↗</a>
        <a class="btn jc-mono" href="https://www.facebook.com/JavaScriptCebu/events">Facebook events ↗</a>
      </div>
    </section>

    <section id="projects" class="block">
      <h2 class="jc-label">Featured project</h2>
      <div class="projects">
        {featured.map((entry) => <ProjectCard entry={entry} />)}
      </div>
      <a class="jc-mono more" href="/projects">All projects →</a>
    </section>

    <section id="community" class="block">
      <figure class="photo">
        <img class="jc-photo" src={photo} alt="The JS Cebu community at a meetup" width="1728" height="1296" loading="lazy" />
        <figcaption class="jc-label">The JS Cebu community at a meetup</figcaption>
      </figure>
    </section>

    <section id="join" class="block">
      <h2 class="jc-label">Join us</h2>
      <p class="big">Come to a meetup, follow along online, or say hello.</p>
      <ul class="join">
        {links.map(({ data }) => <li><a class="btn jc-mono" href={data.url}>{data.label} ↗</a></li>)}
      </ul>
    </section>
  </div>
</Site>

<style>
  .hero {
    position: relative;
    padding: 88px 0 72px;
  }
  .kicker {
    margin: 0;
    font-size: 13px;
    color: var(--jc-accent);
  }
  h1 {
    max-width: 12ch;
    margin: 16px 0 0;
    font-size: clamp(44px, 9vw, 96px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--jc-accent);
  }
  .lede {
    max-width: 46ch;
    margin: 22px 0 0;
    font-size: 19px;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 28px;
  }
  .btn {
    padding: 12px 16px;
    border-radius: 6px;
    border: 1px solid var(--jc-muted);
    color: var(--jc-text);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
  }
  .btn.primary {
    border-color: var(--jc-accent);
    background: var(--jc-accent);
    color: var(--jc-accent-text);
  }
  .hero :global(.hero-sticker) {
    display: block;
    margin: 48px 0 0 8px;
  }
  @media (min-width: 900px) {
    .hero :global(.hero-sticker) {
      position: absolute;
      top: 96px;
      right: 24px;
      margin: 0;
    }
  }

  .block {
    padding: 56px 0;
    border-top: 1px solid var(--jc-line);
    scroll-margin-top: 72px;
  }
  .block h2 {
    margin: 0 0 20px;
    font-size: 13px;
    color: var(--jc-accent);
  }
  .big {
    max-width: 40ch;
    margin: 0;
    font-size: clamp(22px, 3.2vw, 30px);
    line-height: 1.3;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .cards li > * {
    display: block;
    height: 100%;
    box-sizing: border-box;
    padding: 24px;
    border: 1px solid var(--jc-line);
    border-radius: 12px;
    background: color-mix(in srgb, var(--jc-text) 3%, var(--jc-ink));
    color: var(--jc-text);
    text-decoration: none;
  }
  .cards a:hover {
    border-color: var(--jc-accent);
  }
  .cards h3 {
    margin: 0;
    font-size: 22px;
  }
  .cards p {
    margin: 8px 0 0;
    color: var(--jc-muted);
  }

  .projects {
    max-width: 760px;
  }
  .more {
    display: inline-block;
    margin-top: 16px;
    font-size: 14px;
    text-decoration: none;
  }

  .photo {
    margin: 0;
  }
  .photo img {
    width: 100%;
    height: auto;
    aspect-ratio: 21 / 9;
    border-radius: 12px;
  }
  .photo figcaption {
    margin-top: 10px;
    font-size: 12px;
  }

  .join {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
  }
  .join a {
    display: inline-block;
  }
</style>
