---
import Cursor from '../components/Cursor.astro';
import Terminal from '../layouts/Terminal.astro';
---

<Terminal title="Not found · JS Cebu" description="This page doesn't exist.">
  <main>
    <p class="jc-label">// 404</p>
    <h1 class="jc-headline"><Cursor text="Nothing here" blink /></h1>
    <p>That page doesn't exist. The brand guidelines are at <a href="/brand">/brand</a>.</p>
  </main>
</Terminal>

<style>
  main {
    max-width: 720px;
    margin: 0 auto;
    padding: 96px 24px;
  }
  h1 {
    margin: 12px 0 16px;
    font-size: clamp(40px, 8vw, 72px);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--jc-accent);
  }
</style>
