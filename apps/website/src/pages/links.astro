---
import { getCollection } from 'astro:content';
import Cursor from '../components/Cursor.astro';
import Site from '../layouts/Site.astro';

const links = (await getCollection('links')).sort((a, b) => a.data.order - b.data.order);
---

<Site title="Links · JS Cebu" description="JavaScript Cebu's official channels." current="links">
  <div class="wrap">
    <header class="page-head">
      <p class="jc-label">// official links</p>
      <h1 class="jc-headline"><Cursor text="Find JS Cebu" blink animate /></h1>
    </header>
    <ul class="links">
      {
        links.map(({ data }, i) => (
          <li data-reveal style={`--i: ${i}`}>
            <a class="lift" href={data.url}>
              <span class="label">{data.label}</span>
              {data.handle && <span class="jc-mono handle">{data.handle}</span>}
              <span class="jc-mono go" aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Site>

<style>
  .links {
    display: grid;
    gap: 10px;
    max-width: 560px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .links a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 2px 16px;
    padding: 18px 20px;
    border: 1px solid var(--jc-line);
    border-radius: 10px;
    color: var(--jc-text);
    text-decoration: none;
  }
  .links a:hover {
    border-color: var(--jc-accent);
  }
  .label {
    font-size: 18px;
    font-weight: 700;
  }
  .handle {
    grid-row: 2;
    font-size: 13px;
    color: var(--jc-muted);
    overflow-wrap: anywhere;
  }
  .go {
    grid-row: 1 / span 2;
    grid-column: 2;
    color: var(--jc-accent);
  }
</style>
